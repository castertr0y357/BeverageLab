# --- Soda Laboratory Environment Configuration ---

# Security
# Generate a new secret key for production use
SECRET_KEY=django-insecure-soda-lab-$(openssl rand -base64 32)
DEBUG=True
ALLOWED_HOSTS=localhost,127.0.0.1,0.0.0.0
CSRF_TRUSTED_ORIGINS=http://localhost:8000,http://127.0.0.1:8000


# Superuser initialization
DJANGO_SUPERUSER_USERNAME=admin
DJANGO_SUPERUSER_EMAIL=admin@beveragelab.local
DJANGO_SUPERUSER_PASSWORD=adminpass123

# Database
POSTGRES_DB=soda_mixer
POSTGRES_USER=postgres
POSTGRES_PASSWORD=laboratory_secure_password_123
DATABASE_HOST=db
DATABASE_PORT=5432

# Host Ports
WEB_PORT=8000

# Offline Mode
MOCK_MODE=False

# OpenID Connect (Authentik) Configuration
OIDC_ENABLED=False
OIDC_ADMIN_GROUP=authentik Admins
OIDC_REQUIRED_GROUP=
OIDC_RP_CLIENT_ID=beveragelab-oidc-client
OIDC_RP_CLIENT_SECRET=change-me-in-infisical
OIDC_OP_AUTHORIZATION_ENDPOINT=https://auth.castertr0y357.net/application/o/authorize/
OIDC_OP_TOKEN_ENDPOINT=https://auth.castertr0y357.net/application/o/token/
OIDC_OP_USER_ENDPOINT=https://auth.castertr0y357.net/application/o/userinfo/
OIDC_OP_JWKS_ENDPOINT=https://auth.castertr0y357.net/application/o/beveragelab/jwks/
OIDC_OP_LOGOUT_ENDPOINT=https://auth.castertr0y357.net/application/o/beveragelab/end-session/



