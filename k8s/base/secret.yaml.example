apiVersion: v1
kind: Secret
metadata:
  name: beveragelab-secret
type: Opaque
stringData:
  # Generate a secure Django key, e.g. python -c "import secrets; print(secrets.token_urlsafe(50))"
  SECRET_KEY: "change-me-to-a-secure-random-secret-key-for-production"
  POSTGRES_USER: "postgres"
  POSTGRES_PASSWORD: "change-me-to-a-secure-database-password"

